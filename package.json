{
	"name": "@atmosx/event-product-parser",
	"version": "3.0.75",
	"description": "NOAA Weather Wire & NWS API Parser - Built for standalone and Project AtmosphericX Integration.",
	"main": "dist/cjs/index.cjs",
	"module": "dist/esm/index.mjs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AtmosphericX/event-product-parser",
		"branch": "v3-beta-branch"
	},
	"scripts": {
		"start": "cd ./test && node ./index.js",
		"build": "node ./tools/build.js && cd ./test && node index.js",
		"watch": "node ./tools/build.js --watch",
		"publish": "node ./tools/build.js && npm publish --access public",
		"publish-beta-branch": "node ./tools/build.js && npm publish --tag v3-beta-branch --access public"
	},
	"keywords": [
		"NWWS",
		"NOAA Weather Wire Service",
		"TypeScript",
		"XMPP",
		"Parser",
		"JavaScript",
		"CommonJS",
		"ESM"
	],
	"author": "k3yomi, StarflightWx",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/AtmosphericX/event-product-parser/issues"
	},
	"homepage": "https://github.com/AtmosphericX/event-product-parser#readme",
	"dependencies": {
		"@xmpp/client": "0.14.0",
		"better-sqlite3": "12.9.0",
		"croner": "10.0.1",
		"d3-geo": "3.1.1",
		"esbuild": "0.28.1",
		"jszip": "3.10.1",
		"polygon-clipping": "0.15.7",
		"shapefile": "0.6.6",
		"sharp": "0.35.3",
		"topojson-client": "3.1.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "7.6.13",
		"@types/d3-geo": "3.1.0",
		"@types/node": "25.2.0",
		"@types/shapefile": "0.6.4",
		"@types/topojson-client": "3.1.5",
		"@types/xmpp__client": "0.14.1"
	}
}